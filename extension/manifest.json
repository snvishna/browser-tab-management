{
  "manifest_version": 3,
  "name": "TabFlow Agent",
  "version": "1.0.0",
  "description": "State-of-the-art dual-engine AI browser tab lifecycle manager.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "webNavigation",
    "alarms",
    "scripting",
    "activeTab",
    "sessions"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "MacCtrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open Tab Command Palette"
    }
  },
  "action": {
    "default_title": "Open TabFlow Agent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["palette.html", "src/palette.js", "src/palette.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "scripts": ["dist/background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabmanager@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  }
}
